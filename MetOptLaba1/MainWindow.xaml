<Window x:Class="MetOptLaba1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetOptLaba1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Условия задачи">
                <Grid Background="#FFE5E5E5">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Margin="10">
                                <Label Content="Число переменных: "/>
                                <TextBox HorizontalAlignment="Left" TextWrapping="Wrap" Text="4" VerticalAlignment="Top" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <!-- Margin = "LEFT, UP, RIGHT, BOTTOM" -->
                                <Button Content="Применить" Background="Green" Margin="0,0,0,5"/>
                                <Button Content="Выход" Background="Red" Margin="0,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="10">
                            <StackPanel Orientation="Vertical">
                                <Label Content="Целевая функция"/>
                                <DataGrid x:Name="target_func_grid" Loaded="grid_Loaded"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <Label Content="Целевая функция"/>
                                <DataGrid x:Name="ter" Loaded="grid_Loaded"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="TabItem">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
