<Window x:Class="MetOptLaba1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetOptLaba1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl x:Name="tabControl" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Условия задачи">
                <Grid Background="#FFE5E5E5">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Margin="10">
                                <Label Content="Число переменных: "/>
                                <TextBox x:Name="variableAmount" HorizontalAlignment="Left" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120" TextChanged="variableAmount_TextChanged"/>
                                <Label Content="Число ограничений: "/>
                                <TextBox x:Name="constraintAmount" HorizontalAlignment="Left" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120" TextChanged="constraintAmount_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <!-- Margin = "LEFT, UP, RIGHT, BOTTOM" -->
                                <Button x:Name="save" Content="Сохранить" Margin="0,0,0,5" Click="save_Click"/>
                                <Button x:Name="load" Content="Загрузить" Margin="0,0,0,5" Click="load_Click"/>
                                <Button x:Name="apply" Content="Применить" Background="Green" Margin="0,20,0,5" Click="apply_Click"/>
                                <Button x:Name="exit" Content="Выход" Background="Red" Margin="0,0,0,5" Click="exit_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="10">
                            <StackPanel Orientation="Vertical">
                                <Label Content="Целевая функция"/>
                                <DataGrid x:Name="targetGrid" CanUserAddRows="False" Loaded="grid_Loaded"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <Label Content="Ограничения"/>
                                <DataGrid x:Name="constraintGrid" CanUserAddRows="False" Loaded="grid_Loaded"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Симплекс метод">
                <Grid Background="#FFE5E5E5">
                    <StackPanel x:Name = "simplexGrid" Orientation="Vertical" Margin="10">
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
